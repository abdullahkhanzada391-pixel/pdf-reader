# Google Gemini API Key (Get yours at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Selection (e.g., gemini-2.5-flash, gemini-1.5-flash, gemini-2.5-pro)
GEMINI_MODEL=gemini-2.5-flash

# Flask Configuration
FLASK_SECRET_KEY=change-this-in-production-ai-pdf-assistant
FLASK_PORT=5000
FLASK_DEBUG=True

# File Upload Settings
MAX_CONTENT_LENGTH=33554432
UPLOAD_FOLDER=uploads
DATABASE_PATH=database/app.db
